{
  "expo": {
    "name": "云讯",
    "slug": "cloudnews-mobile",
    "scheme": "cloudnews",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#050B14"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cloudnews.mobile",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.cloudnews.mobile"
        ]
      },
      "infoPlist": {
        "RTCAppGroupIdentifier": "group.com.cloudnews.mobile",
        "RTCScreenSharingExtension": "com.cloudnews.mobile.broadcast",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "fetch"
        ],
        "NSCameraUsageDescription": "CloudNews requires camera access for video conferencing.",
        "NSMicrophoneUsageDescription": "CloudNews requires microphone access for audio and voice communication."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/logo.png",
        "backgroundColor": "#050B14"
      },
      "package": "com.cloudnews.mobile",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "FOREGROUND_SERVICE_MICROPHONE",
        "WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./src/assets/images/logo.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-asset",
      "expo-font",
      "@react-native-community/datetimepicker"
    ]
  }
}
